# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# study materials (raw transcripts / copyrighted source - not committed)
# Only the extraction/authoring tooling is tracked; all raw material and
# generated outputs (extracted-questions.json, parsed-transcript.json, PDFs,
# HTML, transcripts) stay ignored.
/study-materials/*
!/study-materials/.gitkeep
!/study-materials/extract-questions.mjs
!/study-materials/parse-transcript.mjs
!/study-materials/author-questions.mjs
!/study-materials/mappings/
/study-materials/mappings/*
!/study-materials/mappings/*.mjs
